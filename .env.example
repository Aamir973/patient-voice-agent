# --- Database ---
# SQLite by default (file lives at ./data/patients.db). Point elsewhere if you swap to Postgres.
DATABASE_URL=sqlite:///./data/patients.db

# --- App ---
# Shared secret Vapi must send back to us so random people can't hit our tool-call endpoint.
VAPI_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Base URL of THIS API once deployed (Railway/Render/ngrok). Used only in docs/scripts, not required at runtime.
PUBLIC_BASE_URL=https://your-app.up.railway.app

# --- Vapi (https://dashboard.vapi.ai) ---
# Only needed if you use scripts/setup_vapi.py to create the assistant + phone number via API
# instead of doing it by hand in the Vapi dashboard.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=

# --- OpenAI (the LLM Vapi will call) ---
# Only needed by scripts/setup_vapi.py if you want it to wire the model for you.
OPENAI_API_KEY=
